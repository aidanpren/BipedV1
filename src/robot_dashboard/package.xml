<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_dashboard</name>
  <version>0.0.0</version>
  <description>Web dashboard (browser/phone) for monitoring and mode control</description>
  <maintainer email="aidan.pren14@gmail.com">roshub</maintainer>
  <license>Apache-2.0</license>

  <!-- the WebSocket bridge the page talks to -->
  <exec_depend>rosbridge_server</exec_depend>
  <!-- SetMode (called by the page) and SaveParams (served by the backend) -->
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- rosapi_node ships inside rosbridge_server and is what lets the page
       enumerate topics and message fields at runtime, which is how the
       generic tiles work without a hardcoded topic list. -->
  <exec_depend>rosbridge_server</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
