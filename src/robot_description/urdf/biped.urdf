<?xml version="1.0"?>
<!-- BipedV1 rough KINEMATIC model for RViz feature testing (no physics).
     Frame convention: origin at body center, X forward, Y left, Z up, metres.
     Each leg: hip (revolute, independent) -> knee (revolute, mimics hip x-2)
     -> wheel (continuous). Equal-length segments keep the wheel directly
     below the hip; symmetric hips = body up/down, differential hips = lean. -->
<robot name="biped">

  <!-- ================= materials (RViz colours) ================= -->
  <material name="body_grey"><color rgba="0.3 0.3 0.35 1.0"/></material>
  <material name="leg_blue"><color rgba="0.1 0.4 0.8 1.0"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <!-- ================= body (root link) ================= -->
  <!-- 11.25 x 8.25 x 5.375 in -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.2858 0.2096 0.1365"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="body_grey"/>
    </visual>
  </link>

  <!-- ================= LEFT LEG ================= -->
  <!-- hip sits at bottom of body, half the 358 mm track out to +Y -->
  <joint name="left_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_upper_leg"/>
    <origin xyz="0 0.179 -0.0683" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.10" upper="1.24" effort="20" velocity="10"/>
  </joint>

  <!-- upper segment: 9.1 in long, 1 in thick, hangs down from hip -->
  <link name="left_upper_leg">
    <visual>
      <geometry>
        <cylinder radius="0.0127" length="0.2311"/>
      </geometry>
      <origin xyz="0 0 -0.1156" rpy="0 0 0"/>
      <material name="leg_blue"/>
    </visual>
  </link>

  <!-- knee: folds the lower segment back at -2x the hip angle so the
       wheel tracks straight down under the hip -->
  <joint name="left_knee_joint" type="revolute">
    <parent link="left_upper_leg"/>
    <child link="left_lower_leg"/>
    <origin xyz="0 0 -0.2311" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.4804" upper="0" effort="20" velocity="10"/>
    <mimic joint="left_hip_joint" multiplier="-2" offset="0"/>
  </joint>

  <link name="left_lower_leg">
    <visual>
      <geometry>
        <cylinder radius="0.0127" length="0.2311"/>
      </geometry>
      <origin xyz="0 0 -0.1156" rpy="0 0 0"/>
      <material name="leg_blue"/>
    </visual>
  </link>

  <!-- wheel: spins about Y (rolls in X). Cylinder rotated so its axle is +Y -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="left_lower_leg"/>
    <child link="left_wheel"/>
    <origin xyz="0 0 -0.2311" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.105" length="0.052"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_black"/>
    </visual>
  </link>

  <!-- ================= RIGHT LEG (mirror of left, -Y) ================= -->
  <joint name="right_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_upper_leg"/>
    <origin xyz="0 -0.179 -0.0683" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.10" upper="1.24" effort="20" velocity="10"/>
  </joint>

  <link name="right_upper_leg">
    <visual>
      <geometry>
        <cylinder radius="0.0127" length="0.2311"/>
      </geometry>
      <origin xyz="0 0 -0.1156" rpy="0 0 0"/>
      <material name="leg_blue"/>
    </visual>
  </link>

  <joint name="right_knee_joint" type="revolute">
    <parent link="right_upper_leg"/>
    <child link="right_lower_leg"/>
    <origin xyz="0 0 -0.2311" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.4804" upper="0" effort="20" velocity="10"/>
    <mimic joint="right_hip_joint" multiplier="-2" offset="0"/>
  </joint>

  <link name="right_lower_leg">
    <visual>
      <geometry>
        <cylinder radius="0.0127" length="0.2311"/>
      </geometry>
      <origin xyz="0 0 -0.1156" rpy="0 0 0"/>
      <material name="leg_blue"/>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="right_lower_leg"/>
    <child link="right_wheel"/>
    <origin xyz="0 0 -0.2311" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.105" length="0.052"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_black"/>
    </visual>
  </link>

</robot>
