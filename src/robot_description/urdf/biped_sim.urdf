<?xml version="1.0"?>
<!-- Minimal PRIMITIVE model of the wheeled biped for Gazebo physics testing.
     Boxes + cylinders only - NO CAD meshes. Meshes are a cosmetic swap-in later;
     physics only needs mass, inertia, collision, and joint axes.
     All numbers are placeholders - tune to your real robot.
     Frame convention: x = forward, y = left, z = up. Units: meters, kg, radians. -->
<robot name="biped">

  <!-- ================= BASE (chassis) ================= -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.20 0.25 0.12"/></geometry>
      <material name="grey"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.20 0.25 0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <!-- box inertia: ixx=m/12(y^2+z^2), iyy=m/12(x^2+z^2), izz=m/12(x^2+y^2) -->
      <inertia ixx="0.01282" ixy="0" ixz="0" iyy="0.00907" iyz="0" izz="0.01708"/>
    </inertial>
  </link>

  <!-- ================= LEFT LEG ================= -->
  <link name="left_leg">
    <visual>
      <origin xyz="0 0 -0.09"/>
      <geometry><box size="0.04 0.04 0.18"/></geometry>
      <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.09"/>
      <geometry><box size="0.04 0.04 0.18"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.09"/>
      <mass value="0.4"/>
      <inertia ixx="0.001133" ixy="0" ixz="0" iyy="0.001133" iyz="0" izz="0.0001067"/>
    </inertial>
  </link>

  <joint name="left_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_leg"/>
    <origin xyz="0 0.1 -0.06"/>          <!-- left side, at base bottom -->
    <axis xyz="0 1 0"/>                  <!-- pitch: leg swings fore/aft -->
    <limit lower="-1.0" upper="1.0" effort="20" velocity="5"/>
  </joint>

  <!-- ================= RIGHT LEG ================= -->
  <link name="right_leg">
    <visual>
      <origin xyz="0 0 -0.09"/>
      <geometry><box size="0.04 0.04 0.18"/></geometry>
      <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.09"/>
      <geometry><box size="0.04 0.04 0.18"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.09"/>
      <mass value="0.4"/>
      <inertia ixx="0.001133" ixy="0" ixz="0" iyy="0.001133" iyz="0" izz="0.0001067"/>
    </inertial>
  </link>

  <joint name="right_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_leg"/>
    <origin xyz="0 -0.1 -0.06"/>         <!-- right side -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="20" velocity="5"/>
  </joint>

  <!-- ================= LEFT WHEEL ================= -->
  <!-- cylinder rotated so its axis lies along Y (the rotation axis) -->
  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.03"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <!-- cylinder, axis along Y: iyy=1/2 m r^2, ixx=izz=1/12 m(3r^2+h^2) -->
      <inertia ixx="0.0002925" ixy="0" ixz="0" iyy="0.00054" iyz="0" izz="0.0002925"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="left_leg"/>
    <child link="left_wheel"/>
    <origin xyz="0 0 -0.18"/>            <!-- bottom of the leg -->
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= RIGHT WHEEL ================= -->
  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.03"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002925" ixy="0" ixz="0" iyy="0.00054" iyz="0" izz="0.0002925"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="right_leg"/>
    <child link="right_wheel"/>
    <origin xyz="0 0 -0.18"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
