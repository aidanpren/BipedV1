<?xml version="1.0"?>
<!-- Stage-1 PHYSICS model of BipedV1 for Gazebo Harmonic.
     Simplified to a 2-wheel INVERTED PENDULUM: hips are FIXED, only the wheels
     move, so the body pitches on the wheel axle. Boxes + cylinders only.
     Numbers are the REAL robot (measured 2026-07-10); leg mass is an estimate.
     Frame: x = forward, y = left, z = up. Units: metres, kg, radians.
     Mass budget (total 8.62 kg): base 4.1 (chassis+battery+2 hip motors),
     each leg 0.5 (est.), each wheel 1.76 (1.36 bare + 0.396 GIM8108 hub). -->
<robot name="biped">

  <!-- ================= BASE (chassis) =================
       box 0.286 x 0.210 x 0.137 m, 4.1 kg
       ixx=m/12(y^2+z^2) iyy=m/12(x^2+z^2) izz=m/12(x^2+y^2) -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.286 0.210 0.137"/></geometry>
      <material name="grey"><color rgba="0.3 0.3 0.35 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.286 0.210 0.137"/></geometry>
    </collision>
    <inertial>
      <mass value="4.1"/>
      <inertia ixx="0.02148" ixy="0" ixz="0" iyy="0.03436" iyz="0" izz="0.04302"/>
    </inertial>
  </link>

  <!-- ================= LEFT LEG =================
       Box 0.04 x 0.04 x 0.160 m, 0.5 kg. 0.160 m = the RETRACTED hip-to-wheel
       distance (leg-forward-kinematics memory: crank 20.28deg). The leg is a
       rigid box that TRANSLATES with the prismatic joint, so it is geometrically
       exact only at the retracted pose it spawns in; at full extension the rigid
       box leaves a cosmetic gap the real four-bar linkage would fill.
       Centre of the box is 0.160/2 = 0.080 below the (retracted) hip. -->
  <link name="left_leg">
    <visual>
      <origin xyz="0 0 -0.080"/>
      <geometry><box size="0.04 0.04 0.160"/></geometry>
      <material name="blue"><color rgba="0.1 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.080"/>
      <geometry><box size="0.04 0.04 0.160"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.080"/>
      <mass value="0.5"/>
      <inertia ixx="0.001133" ixy="0" ixz="0" iyy="0.001133" iyz="0" izz="0.0001333"/>
    </inertial>
  </link>

  <!-- Hips are PRISMATIC: they SLIDE in a straight line, they do not bend.
       Positioned half the 0.358 m track out to +Y, at the bottom of the body
       (z = -0.137/2 = -0.0685).

       WHY NOT THE REAL FOUR-BAR LINKAGE: URDF describes a TREE — every link has
       exactly one parent. A four-bar is a closed RING, which a tree cannot
       express. That is structural, not a Gazebo bug. So we model the EFFECT the
       linkage has (centre of mass moves up and down) rather than the MECHANISM
       (bars pivoting). Balance only cares where the mass ends up.

       AXIS: 0 0 -1 is VERTICAL. (0 1 0 would be sideways — that slides the leg
       left/right and changes the stance width, not the height.) Negating z
       means a POSITIVE joint value slides the leg DOWN relative to the body =
       leg EXTENDS = robot stands TALLER. Positive-is-taller matches the
       "metres of extension" convention.

       UNITS: this joint is METRES of EXTENSION below the retracted stop. The
       real leg_controller works in motor OUTPUT TURNS; sim_leg_bridge converts
       via the real kinematics (leg-forward-kinematics memory), NOT a raw copy —
       0.194 turns of motor travel = 0.302 m here. Numbers do NOT transfer
       one-to-one, only through that map.

       LIMITS — from the real hard stops (leg-forward-kinematics):
         lower 0.0 m       RETRACTED hard stop (crank 20.28deg). 0 = retracted,
                           so the robot SPAWNS retracted/folded — which also
                           matches the real robot booting collapsed.
         upper 0.302 m     EXTENDED hard stop (crank ~90deg, full extension);
                           11.89" of wheel travel.
         effort 200 N      static hold is only ~42 N per leg (8.62 kg over two
                           legs); headroom left for dynamic loads.
         velocity 0.3 m/s  fast enough not to be the binding constraint.
       effort + velocity are REQUIRED on a prismatic <limit>.

       damping resists sliding velocity; it stops the unactuated joint from
       ringing against its limits before a controller is attached. -->
  <joint name="left_hip_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="left_leg"/>
    <origin xyz="0 0.179 -0.0685"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="0.302" effort="200.0" velocity="0.3"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <!-- ================= RIGHT LEG ================= (mirror of left_leg) -->
  <link name="right_leg">
    <visual>
      <origin xyz="0 0 -0.080"/>
      <geometry><box size="0.04 0.04 0.160"/></geometry>
      <material name="blue"><color rgba="0.1 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.080"/>
      <geometry><box size="0.04 0.04 0.160"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.080"/>
      <mass value="0.5"/>
      <inertia ixx="0.001133" ixy="0" ixz="0" iyy="0.001133" iyz="0" izz="0.0001333"/>
    </inertial>
  </link>

  <!-- Mirror of left_hip_joint. Note the axis is IDENTICAL (0 0 -1), not
       mirrored: both legs must extend downward together. Only the mounting
       <origin> differs (-Y instead of +Y). Flipping this axis for "symmetry"
       would make one leg extend while the other retracts. -->
  <joint name="right_hip_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="right_leg"/>
    <origin xyz="0 -0.179 -0.0685"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="0.302" effort="200.0" velocity="0.3"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <!-- ================= LEFT WHEEL =================
       cylinder r 0.105, width 0.052, 1.76 kg, axle along Y.
       iyy=1/2 m r^2 (spin)  ixx=izz=1/12 m(3r^2+h^2) -->
  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.105" length="0.052"/></geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.105" length="0.052"/></geometry>
    </collision>
    <inertial>
      <mass value="1.76"/>
      <inertia ixx="0.005239" ixy="0" ixz="0" iyy="0.009686" iyz="0" izz="0.005239"/>
    </inertial>
  </link>

  <!-- wheel 0.160 m below the hip at the RETRACTED pose; the prismatic joint
       then lowers it up to a further 0.302 m as the leg extends -->

  <joint name="left_wheel_joint" type="continuous">
    <parent link="left_leg"/>
    <child link="left_wheel"/>
    <origin xyz="0 0 -0.160"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= RIGHT WHEEL ================= -->
  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.105" length="0.052"/></geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.105" length="0.052"/></geometry>
    </collision>
    <inertial>
      <mass value="1.76"/>
      <inertia ixx="0.005239" ixy="0" ixz="0" iyy="0.009686" iyz="0" izz="0.005239"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="right_leg"/>
    <child link="right_wheel"/>
    <origin xyz="0 0 -0.160"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= IMU sensor on the body =================
       Gazebo computes true orientation + angular velocity + linear accel and
       publishes on gz topic /imu at 100 Hz; the ros_gz_bridge (in the launch
       file) republishes it as ROS sensor_msgs/Imu on /imu. Needs the
       gz-sim-imu-system plugin, which biped_world.sdf enables. -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <gz_frame_id>base_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ================= ros2_control interface =================
       Declares what each wheel joint exposes: an EFFORT command (torque in)
       and position/velocity state (encoder out). The <hardware> plugin is the
       swap point: gz_ros2_control in sim, your Pico CAN driver on real HW. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Legs take a POSITION command, not effort: you tell a leg WHERE TO BE,
         not how hard to push. This mirrors the real robot, where the leg
         ODrives run in position mode while the wheels run in torque mode.
         Adding these means /joint_states now carries FOUR joints instead of
         two — safe, because balance_controller looks its wheels up by NAME
         (msg.name.index('left_wheel_joint')), not by array position. -->
    <joint name="left_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Loads a controller_manager inside Gazebo, reading controllers.yaml.
       The __CONTROLLERS_YAML__ token is replaced with the real installed path
       by gazebo.launch.py (plain URDF can't do $(find ...) substitution). -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>__CONTROLLERS_YAML__</parameters>
      <!-- How a POSITION command interface is honoured. Without this,
           gz_ros2_control TELEPORTS the joint to the commanded position every
           cycle: infinitely stiff, infinitely fast, load has no effect. With
           it, the joint is driven at velocity = gain * (target - current), so
           the leg moves at a finite speed and sags under load — which is what
           makes "does the LQR survive a retraction" a meaningful question.
           Tune by observation: too low = the legs sag badly or never arrive;
           too high = they slam into the limits and the robot jumps. -->
      <position_proportional_gain>1.0</position_proportional_gain>
    </plugin>
  </gazebo>

</robot>
