<?xml version="1.0" ?>
<!-- BipedV1 sim world = stock gz "empty" world + the IMU system enabled.
     Gazebo systems are opt-in; without gz-sim-imu-system an <imu> sensor
     produces nothing. Ground plane + sun copied from the stock empty.sdf. -->
<sdf version="1.6">
  <world name="biped">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <!-- the one we're adding: makes IMU sensors actually run -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ============ balance test course (drive in +x from spawn) ============
         bumps at x=2.0/2.6 (3 cm cable-bumps vs the 10.5 cm wheel radius),
         8-degree ramp at x=4 up to a 22 cm plateau, mirrored ramp down. -->
    <model name="bump_1">
      <static>true</static>
      <pose>2.0 0 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.03</radius><length>1.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.03</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient><diffuse>0.8 0.6 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bump_2">
      <static>true</static>
      <pose>2.6 0 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.03</radius><length>1.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.03</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient><diffuse>0.8 0.6 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ramp_up">
      <static>true</static>
      <pose>4.0 0 0.09 0 -0.1396 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 1.2 0.04</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 1.2 0.04</size></box></geometry>
          <material><ambient>0.3 0.5 0.8 1</ambient><diffuse>0.3 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="plateau">
      <static>true</static>
      <pose>5.55 0 0.11 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 1.2 0.22</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 1.2 0.22</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ramp_down">
      <static>true</static>
      <pose>7.1 0 0.09 0 0.1396 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 1.2 0.04</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 1.2 0.04</size></box></geometry>
          <material><ambient>0.3 0.5 0.8 1</ambient><diffuse>0.3 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
