# /etc/default/biped — configuration for the BipedV1 systemd units.
# Installed by deploy/install.sh. Edit IN PLACE on the Pi; no rebuild needed.
#
# ---------------------------------------------------------------------------
# FORMAT WARNING. This file is read TWO ways:
#   1. by systemd, via `EnvironmentFile=` — systemd does NOT run a shell here.
#      No command substitution, no $VAR expansion, no globs, no `export`.
#   2. by the helper scripts in /usr/local/lib/biped, via `.` (source) — which
#      IS a shell, and would happily expand things systemd ignores.
# Anything clever would therefore mean two different values depending on who
# read it. Keep every line a plain, literal KEY=value.
# ---------------------------------------------------------------------------

# --- where the code lives --------------------------------------------------
# Must be the colcon workspace root — the directory containing install/setup.bash.
BIPED_WS=/home/aidanpren/BipedV1

# The ROS 2 underlay. Jazzy; see CLAUDE.md for why we are not on Lyrical Luth.
ROS_DISTRO_SETUP=/opt/ros/jazzy/setup.bash

# What to launch. Overridable so you can point the service at a smaller launch
# file while debugging without editing the unit.
BIPED_LAUNCH_PKG=robot_bringup
BIPED_LAUNCH_FILE=real.launch.py
# Extra `key:=value` launch arguments, space separated. Leave empty for normal
# operation. Example for a bench run with no motors:
#   BIPED_LAUNCH_ARGS=can_channel:=vcan0 imu_driver:=fake
BIPED_LAUNCH_ARGS=

# --- CAN --------------------------------------------------------------------
# Interface name slcand renames the netdev to. real.yaml's odrive_bridge and
# leg_controller both say can0; if you change it here, change it there too or
# the nodes open an interface that does not exist.
CAN_IFACE=can0

# slcand's -s speed index. 6 = 500 kbps, which is what the ODrives are
# configured for (see HARDWARE_BRINGUP.md). This is an INDEX, not a bitrate:
# s0=10k s1=20k s2=50k s3=100k s4=125k s5=250k s6=500k s7=800k s8=1M.
CAN_SPEED_INDEX=6

# Which serial device the CANable is. LEAVE EMPTY for auto-detection, which is
# the recommended setting: biped-can-start.sh resolves it through
# /dev/serial/by-id/, a path keyed on the USB descriptor and serial number, so
# it survives the re-enumeration that moves /dev/ttyACM0 to /dev/ttyACM1.
# Set it explicitly ONLY if you end up with more than one CDC-ACM device on the
# Pi and auto-detection reports an ambiguity. Prefer a by-id path even then:
#   CAN_DEVICE=/dev/serial/by-id/usb-CANable-if00
CAN_DEVICE=

# Seconds to wait at boot for that device to appear. USB enumeration is not
# instant and systemd starts units eagerly, so without this the service would
# lose a race it could simply have waited out.
CAN_DEVICE_WAIT=20

# --- ROS networking ---------------------------------------------------------
# Must match the laptop driver station, or DDS discovery silently finds nothing
# and the dashboard sits at "closed" with no error anywhere.
ROS_DOMAIN_ID=0

# Jazzy's replacement for the deprecated ROS_LOCALHOST_ONLY. SUBNET = discover
# peers on the LAN, which is exactly what CLAUDE.md goal 2 (optional driver
# station) needs. LOCALHOST here would make the robot invisible to the laptop
# and to a phone on the hotspot.
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# --- WiFi role (piece D) ----------------------------------------------------
# The Pi 5 has ONE radio and cannot usefully be an access point and a home-WiFi
# client at the same time. biped-wifi-mode.sh decides which, and is the ONLY
# thing that decides — the AP profile is created with autoconnect=no so that
# NetworkManager does not hold a competing opinion.
WIFI_IFACE=wlan0

# Name of the AP profile, and the SSID it broadcasts. Created once by
# biped-wifi-setup.sh, which also takes the WPA2 passphrase — the passphrase
# lives in NetworkManager's root-only connection store and NEVER in this repo.
WIFI_AP_CON=biped-ap
WIFI_AP_SSID=BipedV1

# Which profile counts as "home". EMPTY = auto-detect: any saved wireless
# profile that is not the AP. Leaving it empty means a network you join
# normally, later, is picked up with no extra configuration step.
WIFI_HOME_CON=

# Whether to leave the AP automatically when home WiFi reappears.
#
# DEFAULT FALSE, and the reason is not conservatism. Most drivers CANNOT SCAN
# while operating as an AP on the same radio, so "notice home WiFi is back" is
# not passive observation — it requires tearing the AP down to look. That
# outage would land while you are driving with a phone on the AP. Staying on
# the AP too long costs you a `git pull` you will notice; dropping it costs you
# telemetry while the robot is live.
# Switch back deliberately instead:  biped-wifi-mode.sh home
WIFI_RETURN_TO_HOME=false

# If you do enable the above: how many consecutive checks must see home WiFi
# before switching. Hysteresis, so one lucky scan at the edge of range does not
# drop your dashboard.
WIFI_HOME_CONFIRM_CHECKS=3
